#!/bin/sh
set -eu

branch=$(git symbolic-ref --quiet --short HEAD) || {
    printf '%s\n' 'Commit from a named topic branch, not a detached HEAD.' >&2
    exit 1
}

if [ "$branch" = main ]; then
    if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
        exit 0
    fi
    printf '%s\n' 'Direct commits to main are disabled. Create a topic branch and open a PR.' >&2
    exit 1
fi

if ! printf '%s\n' "$branch" | grep -Eq '^(feat|fix|docs|chore|refactor|perf|test|build|ci|style|revert)/[a-z0-9]+(-[a-z0-9]+)*$'; then
    printf '%s\n' 'Use a branch such as feat/settings-menu or fix/dialogue-resume. See CONTRIBUTING.md.' >&2
    exit 1
fi
